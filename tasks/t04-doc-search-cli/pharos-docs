#!/usr/bin/env python3
"""pharos-docs -- answer Pharos developer questions via the Developer Docs MCP.

A thin, honest wrapper around the REAL Pharos Developer Docs MCP:

    https://docs.pharos.xyz/~gitbook/mcp        (public, no auth)

Every query goes through the MCP's `searchDocumentation` tool (or `getPage` /
`askQuestion` in the matching modes). Nothing is answered from a local index,
nothing is scraped, nothing is invented.

Every technical answer carries exactly one label:
  DOC-GROUNDED ... verbatim excerpt(s) from MCP search results, doc URL + date
  UNVERIFIED   ... no MCP result covers the question; no answer given (exit 2)

Usage:
  pharos-docs "how do I deploy a contract?"
  pharos-docs --json "what is the Atlantic testnet chain id?"
  pharos-docs --page <doc-url>        # full page text via the getPage tool
  pharos-docs --ask "question"        # synthesized answer via askQuestion tool
  pharos-docs --raw-log <path> "q"    # also dump the raw MCP response text
                                      # (evidence + machine-check tests)

Exit codes: 0 = grounded answer, 2 = no good answer (UNVERIFIED), 1 = error.

Stdlib Python only. Read-only: zero chain interaction, zero spend.
"""
import argparse
import datetime
import json
import os
import re
import sys

BASE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(BASE, "src"))
from docs_mcp import DocsMCP, DocsMCPError, parse_search_results  # noqa: E402

MCP_ENDPOINT = "https://docs.pharos.xyz/~gitbook/mcp"
TOP_N = 3

# --------------------------------------------------------------------------
# Relevance gate: searchDocumentation always returns ~10 results, even for
# out-of-scope questions. A result COVERS the question only if the question's
# distinctive terms are actually present in the result's title+content.
# Distinctive = length >= 3, not a generic word. All LONG terms (>= 6 chars)
# must be present (they carry the meaning), plus at least half of all terms.
# Synonym bridging is vocabulary mapping only -- it never creates content.
# --------------------------------------------------------------------------

STOPWORDS = set(
    """a an the and or of to in on for is are was were be been by with as at
    from that this it its you your we they he she his her their our my i do does did
    not no yes can could should would will just how what when where which who whom
    whose why me us them him her than then so such if but about into over after
    before between under again once here there all any both each few more most other
    some only own same too very don t s re ll ve m d also than then out off per via
    use using used get getting got make made run running set need needs wanted want
    like show shows shown tell tells give given take takes""".split()
)

# Honest vocabulary bridging: docs say "PHRS"/"pros" where users say "tokens".
SYNONYMS = {
    "tokens": ["token", "pros", "phrs"],
    "token": ["tokens", "pros", "phrs"],
    "deploy": ["deploy", "deployment", "deploying", "deployed"],
    "deploys": ["deploy", "deployment"],
    "bridge": ["bridge", "bridging", "bridged"],
    "bridging": ["bridge", "bridging"],
    "oracle": ["oracle", "oracles"],
    "oracles": ["oracle"],
    "faucet": ["faucet"],
    "mcp": ["mcp"],
}


def distinctive_terms(question):
    terms = []
    for t in re.findall(r"[a-z0-9]{3,}", question.lower()):
        if t not in STOPWORDS and t not in terms:
            terms.append(t)
    return terms


def term_present(term, haystack):
    if term in haystack:
        return True
    for syn in SYNONYMS.get(term, []):
        if syn in haystack:
            return True
    return False


def covers(result, terms):
    """True if the MCP result genuinely covers the question's terms."""
    hay = (result["title"] + "\n" + result["content"]).lower()
    long_terms = [t for t in terms if len(t) >= 6]
    if long_terms and not all(term_present(t, hay) for t in long_terms):
        return False
    hits = sum(1 for t in terms if term_present(t, hay))
    return hits >= max(1, (len(terms) + 1) // 2)


def pick_excerpt(content, terms, width=420):
    """Verbatim window around the densest cluster of question terms."""
    low = content.lower()
    positions = []
    for t in terms:
        for variant in [t] + SYNONYMS.get(t, []):
            start = 0
            while True:
                i = low.find(variant, start)
                if i < 0:
                    break
                positions.append(i)
                start = i + 1
    if not positions:
        excerpt = content[:width]
    else:
        positions.sort()
        best_start, best_count = 0, 0
        for p in positions:
            count = sum(1 for q in positions if p <= q <= p + width)
            if count > best_count:
                best_count, best_start = count, p
        s = max(0, best_start - 60)
        nl = content.rfind("\n", 0, s)
        if nl != -1 and s - nl < 120:
            s = nl + 1
        excerpt = content[s:s + width]
        e = content.find("\n", s + width)
        if e != -1 and e - (s + width) < 120:
            excerpt = content[s:e]
    return excerpt.strip()


def answer_cards(results, terms, top_n=TOP_N):
    cards = []
    for r in results:
        if not covers(r, terms):
            continue
        cards.append({
            "page_title": r["title"],
            "page_url": r["link"],
            "excerpt": pick_excerpt(r["content"], terms),
        })
        if len(cards) >= top_n:
            break
    return cards


def closest_pages(results, n=3):
    """For the miss path: the top search hits offered as browse suggestions
    (honestly labeled -- these are search results, not answers)."""
    out = []
    for r in results[:n]:
        out.append({"page_title": r["title"], "page_url": r["link"]})
        if len(out) >= n:
            break
    return out


def cmd_search(question, raw_log=None, top_n=TOP_N):
    mcp = DocsMCP()
    content = mcp.search(question)
    raw_text = DocsMCP.content_text(content)
    if raw_log:
        with open(raw_log, "w", encoding="utf-8") as f:
            f.write(raw_text)
    results = parse_search_results(raw_text)
    terms = distinctive_terms(question)
    cards = answer_cards(results, terms, top_n)
    today = datetime.date.today().isoformat()
    if cards:
        return {
            "label": "DOC-GROUNDED",
            "exit_code": 0,
            "question": question,
            "mcp_endpoint": MCP_ENDPOINT,
            "mcp_tool": "searchDocumentation",
            "retrieved": today,
            "citations": [
                {"page_title": c["page_title"], "page_url": c["page_url"],
                 "retrieved": today, "excerpt": c["excerpt"]}
                for c in cards
            ],
        }
    return {
        "label": "UNVERIFIED",
        "exit_code": 2,
        "question": question,
        "mcp_endpoint": MCP_ENDPOINT,
        "mcp_tool": "searchDocumentation",
        "retrieved": today,
        "citations": [],
        "closest_pages": closest_pages(results),
        "note": ("No good answer found. The Developer Docs MCP returned %d result(s) "
                 "but none covers this question above the relevance gate, so this "
                 "tool will not improvise an answer." % len(results)),
    }


def cmd_page(url, raw_log=None):
    mcp = DocsMCP()
    content = mcp.get_page(url)
    raw_text = DocsMCP.content_text(content)
    if raw_log:
        with open(raw_log, "w", encoding="utf-8") as f:
            f.write(raw_text)
    return {
        "label": "DOC-GROUNDED",
        "exit_code": 0,
        "page_url": url,
        "mcp_endpoint": MCP_ENDPOINT,
        "mcp_tool": "getPage",
        "retrieved": datetime.date.today().isoformat(),
        "page_markdown": raw_text,
    }


def cmd_ask(question, raw_log=None):
    mcp = DocsMCP()
    content = mcp.ask(question)
    raw_text = DocsMCP.content_text(content)
    if raw_log:
        with open(raw_log, "w", encoding="utf-8") as f:
            f.write(raw_text)
    return {
        "label": "DOC-GROUNDED",
        "exit_code": 0,
        "question": question,
        "mcp_endpoint": MCP_ENDPOINT,
        "mcp_tool": "askQuestion",
        "retrieved": datetime.date.today().isoformat(),
        "answer": raw_text,
        "note": ("Synthesized by the Docs MCP answer engine over the docs corpus; "
                 "source links are inside the answer text."),
    }


def render_text(doc):
    lines = []
    q = doc.get("question") or doc.get("page_url", "")
    lines.append("QUESTION")
    lines.append("  " + q)
    lines.append("")
    lines.append("LABEL: " + doc["label"])
    lines.append("")
    if doc["label"] == "DOC-GROUNDED" and "citations" in doc:
        lines.append("ANSWER (verbatim excerpts from the Developer Docs MCP; nothing added)")
        for c in doc["citations"]:
            lines.append("> " + c["excerpt"].replace("\n", "\n> "))
            lines.append("-- " + c["page_title"])
            lines.append("   Source: %s (via Docs MCP, retrieved %s)"
                         % (c["page_url"], c["retrieved"]))
            lines.append("")
        lines.append("MCP: %s :: %s" % (doc["mcp_endpoint"], doc["mcp_tool"]))
    elif "page_markdown" in doc:
        lines.append(doc["page_markdown"][:4000])
        lines.append("")
        lines.append("MCP: %s :: %s" % (doc["mcp_endpoint"], doc["mcp_tool"]))
    elif "answer" in doc:
        lines.append(doc["answer"])
        lines.append("")
        lines.append("MCP: %s :: %s" % (doc["mcp_endpoint"], doc["mcp_tool"]))
        lines.append(doc["note"])
    else:
        lines.append(doc["note"])
        lines.append("")
        if doc.get("closest_pages"):
            lines.append("Closest pages in the docs (browse suggestions, not answers):")
            for p in doc["closest_pages"]:
                lines.append("  - %s\n    %s" % (p["page_title"], p["page_url"]))
    return "\n".join(lines).rstrip() + "\n"


def main(argv=None):
    ap = argparse.ArgumentParser(
        description="Answer Pharos developer questions via the Developer Docs MCP.")
    ap.add_argument("question", nargs="?", help="natural-language question")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--page", metavar="URL", help="fetch a full doc page via getPage")
    ap.add_argument("--ask", action="store_true",
                    help="use the askQuestion tool (synthesized answer)")
    ap.add_argument("--top", type=int, default=TOP_N, help="max answer cards")
    ap.add_argument("--raw-log", metavar="PATH",
                    help="also write the raw MCP response text (for evidence/tests)")
    args = ap.parse_args(argv)

    try:
        if args.page:
            doc = cmd_page(args.page, raw_log=args.raw_log)
        elif args.ask:
            if not args.question:
                ap.error("--ask needs a question")
            doc = cmd_ask(args.question, raw_log=args.raw_log)
        else:
            if not args.question:
                ap.error("a question is required")
            doc = cmd_search(args.question, raw_log=args.raw_log, top_n=args.top)
    except DocsMCPError as e:
        sys.stderr.write("ERROR: Docs MCP call failed: %s\n" % e)
        return 1

    if args.json:
        sys.stdout.write(json.dumps(doc, indent=2, ensure_ascii=False) + "\n")
    else:
        if "page_markdown" in doc:
            sys.stdout.write(doc["page_markdown"])
        else:
            sys.stdout.write(render_text(doc))
    return doc["exit_code"]


if __name__ == "__main__":
    sys.exit(main())
